# Copier ce fichier en ".env.local" à la racine du projet Symfony, puis adapter.
# XAMPP : utilisateur root, mot de passe vide. serverVersion = version affichée par phpMyAdmin (MariaDB sous XAMPP).
APP_ENV=dev
DATABASE_URL="mysql://root:@127.0.0.1:3306/tp_commande_sf?serverVersion=10.4.32-MariaDB&charset=utf8mb4"

# Compte du sujet d'examen (caractères spéciaux à encoder : @ devient %40) :
# DATABASE_URL="mysql://MasTMound2:MoundMasT2%402026@127.0.0.1:3306/NOM_DE_LA_BASE?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
